# ==========================================================================
# CampusFlow - contoh konfigurasi lingkungan
# Salin menjadi .env lalu sesuaikan. JANGAN pernah commit .env yang asli.
#   Windows PowerShell : Copy-Item .env.example .env
#   Git Bash / Linux   : cp .env.example .env
# ==========================================================================

# --- Server ----------------------------------------------------------------
# Port HTTP untuk Express
PORT=3000
# Host bind. 127.0.0.1 = hanya bisa diakses dari komputer ini (aman).
# Ganti 0.0.0.0 hanya jika memang ingin diakses dari perangkat lain di LAN.
HOST=127.0.0.1

# --- Autentikasi -----------------------------------------------------------
# Hasilkan dengan:  npm run hash-pin -- 1234
# Format: scrypt$<saltHex>$<hashHex>
ADMIN_PIN_HASH=

# Umur sesi login dalam milidetik. Default 30 hari.
SESSION_TTL_MS=2592000000

# Rate limit login untuk menahan brute force PIN (percobaan per window)
LOGIN_RATE_LIMIT=8
LOGIN_RATE_WINDOW_MS=900000

# --- Telegram --------------------------------------------------------------
# Token dari @BotFather
TELEGRAM_BOT_TOKEN=
# Opsional: batasi notifikasi ke chat ID tertentu (single-user safety net).
# Kalau kosong, chat_id diambil dari alur linking di UI.
TELEGRAM_CHAT_ID=

# --- Notifikasi ------------------------------------------------------------
# Zona waktu untuk jendela deadline. WAJIB: host yang berjalan di UTC akan
# membuat "<24 jam" meleset beberapa jam dan notifikasi datang di waktu salah.
NOTIFY_TIMEZONE=Asia/Jakarta

# Cron ekspresi untuk engine notifikasi (blueprint: setiap 15 menit)
NOTIFY_CRON=*/15 * * * *

# 3-tier escalation: jumlah jam sebelum deadline untuk tiap tingkat.
# Pisah dengan koma. Example: 24,3,1
NOTIFY_THRESHOLDS=24,3,1

# --- Database --------------------------------------------------------------
# Lokasi file SQLite. Relatif terhadap folder project.
DB_FILE=data/campusflow.db

# --- Produksi --------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
